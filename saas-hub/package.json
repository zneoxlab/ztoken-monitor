{
  "name": "token-monitor-saas-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS hub for ZT Monitor — user accounts, JWT auth, MySQL-backed device aggregation. Reuses src/shared/ sync & merge logic.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "verify": "npm run lint && npm test"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
