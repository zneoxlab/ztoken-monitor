# SaaS Hub — 环境变量配置
# 复制为 .env 并填写实际值。前缀 SAAS_HUB_* 避免与主项目 TOKEN_MONITOR_* 冲突。

# ---- Server ----
SAAS_HUB_PORT=8787
SAAS_HUB_HOST=0.0.0.0
# 浏览器客户端 CORS 允许来源，'*' 允许所有
SAAS_HUB_CORS_ORIGIN=*

# ---- JWT ----
# 生成强随机密钥：openssl rand -hex 32
SAAS_HUB_JWT_SECRET=
# access token 过期时间，jsonwebtoken 格式：'90d' / '1h' / '3600'(秒)。默认 90 天
SAAS_HUB_JWT_EXPIRES_IN=90d
# refresh token 过期时间（格式同上）。默认 90 天，与 access 一致；widget 静默续期
SAAS_HUB_REFRESH_EXPIRES_IN=90d

# ---- MySQL ----
# 方式一：完整 DSN（优先）
SAAS_HUB_MYSQL_URL=
# 方式二：分字段（SAAS_HUB_MYSQL_URL 为空时使用）
SAAS_HUB_MYSQL_HOST=127.0.0.1
SAAS_HUB_MYSQL_PORT=3306
SAAS_HUB_MYSQL_USER=root
SAAS_HUB_MYSQL_PASSWORD=
SAAS_HUB_MYSQL_DATABASE=token_monitor_saas
SAAS_HUB_MYSQL_CONNECTION_LIMIT=10

# ---- 设备新鲜度 ----
# 设备过期阈值（毫秒）：now - receivedAt > 此值则标记 stale。默认 10 分钟
SAAS_HUB_STALE_AFTER_MS=600000

# ---- 密码策略 ----
SAAS_HUB_PASSWORD_MIN_LENGTH=8

# ---- 配额系统推送（由同一个 Hub 进程后台运行）----
# 生成独立的 32 字节十六进制密钥：openssl rand -hex 32
# 用于加密数据库中的 FCM/APNs device token；不要与 JWT 密钥复用。
SAAS_HUB_PUSH_TOKEN_ENCRYPTION_KEY=
SAAS_HUB_PUSH_POLL_INTERVAL_MS=5000
SAAS_HUB_PUSH_BATCH_SIZE=50
SAAS_HUB_PUSH_LEASE_MS=60000
SAAS_HUB_PUSH_MAX_ATTEMPTS=8

# Android FCM HTTP v1：只填写服务账号 JSON 的服务器本地绝对路径。
SAAS_HUB_FCM_SERVICE_ACCOUNT_FILE=

# iOS 直连 APNs：.p8 文件只保存在服务器，不提交仓库。
SAAS_HUB_APNS_KEY_FILE=
SAAS_HUB_APNS_KEY_ID=
SAAS_HUB_APNS_TEAM_ID=
SAAS_HUB_APNS_BUNDLE_ID=com.zneox.ztoken.ztokenMonitor

# ---- Phase 2 预留（Phase 1 不使用）----
# 多实例部署时的跨实例 SSE 广播 / JWT 黑名单 / 分布式锁
# SAAS_HUB_REDIS_URL=
